[Unit]
Description=YouTube AI Video Telegram Bot
After=network.target

[Service]
# DIQQAT: agar loyihani boshqa papkaga joylashtirgan bo'lsangiz,
# quyidagi ikkita yo'lni ("WorkingDirectory" va "ExecStart") shunga moslang.
WorkingDirectory=/root/youtube_bot
ExecStart=/root/youtube_bot/venv/bin/python /root/youtube_bot/bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
