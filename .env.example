# Bu faylni ".env" nomi bilan nusxalab, haqiqiy kalitlarni kiriting.
# Hech qachon haqiqiy kalitlar bilan faylni internetga (GitHub va h.k.) yuklamang.

# Bu faylni ".env" nomi bilan nusxalab, haqiqiy kalitlarni kiriting.
# Hech qachon haqiqiy kalitlar bilan faylni internetga (GitHub va h.k.) yuklamang.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# --- AI-generatsiya rasmlar (stock o'rniga original vizual, tavsiya etiladi) ---
USE_AI_IMAGES=true

# --- Ixtiyoriy: 2GB fayl limiti uchun local server (README.md'dagi yo'riqnomaga qarang) ---
USE_LOCAL_API_SERVER=false
LOCAL_API_SERVER_URL=http://localhost:8081

# --- Ixtiyoriy: bir vaqtda nechta video parallel ishlansin (qolganlari navbatda kutadi) ---
# Server RAM'iga qarab sozlang: 2GB RAM -> 1, 4GB RAM -> 2, 8GB RAM -> 3-4
MAX_CONCURRENT_JOBS=2

# --- To'lov tizimi ---
FREE_MINUTES=50
# Sizning shaxsiy Telegram ID'ingiz (@userinfobot orqali aniqlanadi) — to'lov bildirishnomalari shu yerga keladi
ADMIN_TELEGRAM_ID=
# Qo'lda to'lov qilish uchun ko'rsatma (Click raqami yoki karta)
PAYMENT_INSTRUCTIONS=Click: +998 XX XXX XX XX

# --- Click.uz avtomatik to'lov (ixtiyoriy, domen+SSL talab qiladi, README'ga qarang) ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- Tezkor to'ldirish: SMS orqali avtomatik aniqlash (Click shartnomasisiz ishlaydi) ---
PAYMENT_CARD_NUMBER=9860 XXXX XXXX XXXX
PAYMENT_CARD_OWNER=Ism Familiya
RATE_PER_MINUTE=500
MIN_TOPUP_AMOUNT=1000
SMS_WEBHOOK_SECRET=uzun-tasodifiy-parol-shu-yerga
SMS_MATCH_WINDOW_MINUTES=30
